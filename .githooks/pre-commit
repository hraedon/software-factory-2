#!/usr/bin/env bash
# Pre-commit hook: enforce make check (lint + audit + test).
# Install with: git config core.hooksPath .githooks

set -euo pipefail

echo "Running make check (lint + audit + test)..."
if ! make check; then
    echo ""
    echo "ERROR: make check failed. Fix lint/audit/test errors before committing."
    echo "Run 'make check' manually to see full output."
    exit 1
fi
